# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional Server Secretariat & Webhook Configuration (configure in Server Secrets only)
# ADMIN_BOOTSTRAP_EMAIL="admin@eternal2027.org"
# ADMIN_BOOTSTRAP_PASSWORD=""
# ADMIN_SESSION_SECRET=""
# RAZORPAY_WEBHOOK_SECRET=""
# STRIPE_WEBHOOK_SECRET=""
# PAYMENT_WEBHOOK_SECRET=""

# MySQL (production persistence target; see PROJECT_ETERNAL_DATABASE_ASSESSMENT.md).
# Leave unset to keep running on the legacy JSON-file store during the migration window.
# DATABASE_URL="mysql://eternal_app:CHANGE_ME@localhost:3306/project_eternal"
# DATABASE_POOL_SIZE="10"

# MySQL is REQUIRED for durable data on hosts with an ephemeral disk (Render, Railway, etc.):
# without it, registrations/payments/passes live in .data/platform-db.json and are lost on
# every redeploy. With it, tables are created automatically on boot (server/db/migrations)
# and every registration, payment, pass and notification is written through to MySQL.

# Payments — Razorpay powers UPI (GPay/PhonePe/Paytm/FamPay/BHIM…), cards, net banking, wallets.
# rzp_test_ keys = Razorpay test mode; rzp_live_ keys = real money.
# RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
# RAZORPAY_KEY_SECRET=""
# Point the Razorpay dashboard webhook at https://<your-domain>/api/payments/webhook
# (events: payment.captured, payment.failed, refund.processed) using this secret:
# RAZORPAY_WEBHOOK_SECRET=""

# With NO Razorpay keys, a built-in TEST gateway runs the full checkout end-to-end and labels
# everything "Test mode" (no money moves). Set to "disabled" to turn it off in production.
# PAYMENT_SANDBOX="disabled"

# Social profiles for the new organisation (build-time; leave unset to hide the links).
# VITE_SOCIAL_INSTAGRAM="https://instagram.com/..."
# VITE_SOCIAL_FACEBOOK="https://facebook.com/..."
# VITE_SOCIAL_X="https://x.com/..."
# VITE_SOCIAL_YOUTUBE="https://youtube.com/@..."
