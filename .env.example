# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional Server Secretariat & Webhook Configuration (configure in Server Secrets only)
# ADMIN_BOOTSTRAP_EMAIL="admin@eternal2027.org"
# ADMIN_BOOTSTRAP_PASSWORD=""
# ADMIN_SESSION_SECRET=""
# RAZORPAY_WEBHOOK_SECRET=""
# STRIPE_WEBHOOK_SECRET=""
# PAYMENT_WEBHOOK_SECRET=""

# MySQL (production persistence target; see PROJECT_ETERNAL_DATABASE_ASSESSMENT.md).
# Leave unset to keep running on the legacy JSON-file store during the migration window.
# DATABASE_URL="mysql://eternal_app:CHANGE_ME@localhost:3306/project_eternal"
# DATABASE_POOL_SIZE="10"

# Razorpay (Phase 3/8 payment integration). Use TEST MODE keys until verified end-to-end.
# RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
# RAZORPAY_KEY_SECRET=""
